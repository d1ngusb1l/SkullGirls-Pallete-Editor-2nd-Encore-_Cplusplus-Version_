#include <windows.h>
#include "ReleaseVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SGPE_VERSION_RESOURCE
 PRODUCTVERSION SGPE_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
#ifdef SGPE_DLL_RESOURCE
 FILETYPE VFT_DLL
#else
 FILETYPE VFT_APP
#endif
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Skullgirls Palette Editor\0"
            VALUE "FileVersion", SGPE_VERSION "\0"
            VALUE "ProductName", "Skullgirls Palette Editor\0"
            VALUE "ProductVersion", SGPE_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
